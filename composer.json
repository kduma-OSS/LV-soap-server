{
    "name": "kduma/laravel-soap-server",
    "description": "Laravel SOAP service server",
    "keywords": [
        "kduma",
        "laravel-soap-server"
    ],
    "homepage": "https://github.com/kduma/laravel-soap-server",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Krystian Duma",
            "email": "git@krystian.duma.sh",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-soap": "*",
        "laminas/laminas-soap": "^2.11 || ^3.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0",
        "phpunit/phpunit": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "KDuma\\SoapServer\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KDuma\\SoapServer\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "KDuma\\SoapServer\\LaravelSoapServerServiceProvider"
            ]
        }
    }
}
